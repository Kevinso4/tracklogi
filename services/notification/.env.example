# Variables de entorno de Notification Service. Copia este archivo a .env y ajusta los valores.
# Nunca subas el .env real: en la nube (Render) se configuran en el panel de la plataforma.

# Conexión a la base de datos propia del servicio
DATABASE_URL=postgresql+psycopg://logitrack:logitrack@postgres:5432/notification_db

# Conexión a RabbitMQ (bus de eventos)
RABBITMQ_URL=amqp://logitrack:logitrack@rabbitmq:5672/

# Opcional. Esquema propio cuando varios servicios comparten una instancia (Render)
DB_SCHEMA=

# Nivel de los logs JSON
LOG_LEVEL=INFO

# Servidor de correo. Vacío: notificaciones simuladas
SMTP_HOST=mailpit

# Puerto SMTP (Mailtrap: 2525)
SMTP_PORT=1025

# Usuario SMTP (Mailtrap). Con usuario se usa STARTTLS
SMTP_USER=

# Clave SMTP. Nunca se sube al repositorio
SMTP_PASSWORD=

# Remitente de los correos
NOTIFICACIONES_REMITENTE=LogiTrack <notificaciones@logitrack.co>

# Destinatario de las alertas de mantenimiento
CORREO_GESTOR=gestor.flota@logitrack.co
