# Variables de entorno de API Gateway. Copia este archivo a .env y ajusta los valores.
# Nunca subas el .env real: en la nube (Render) se configuran en el panel de la plataforma.

# Conexión a RabbitMQ (bus de eventos)
RABBITMQ_URL=amqp://logitrack:logitrack@rabbitmq:5672/

# Redis para el rate limiting y los refresh tokens
REDIS_URL=redis://redis:6379/0

# Clave privada RSA (PEM) para firmar los JWT. Vacía: se genera una temporal
JWT_PRIVATE_KEY=

# Vida del access token
JWT_ACCESS_MINUTOS=15

# Vida del refresh token
JWT_REFRESH_DIAS=7

# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000

# true en producción (HTTPS)
COOKIE_SECURE=false

# Tiempo máximo de espera de un microservicio
PROXY_TIMEOUT_S=60

# Dirección interna de Fleet
FLEET_URL=http://fleet:8000

# Dirección interna de Tracking
TRACKING_URL=http://tracking:8000

# Dirección interna de Shipment
SHIPMENT_URL=http://shipment:8000

# Dirección interna de Maintenance
MAINTENANCE_URL=http://maintenance:8000

# Dirección interna de Routing
ROUTING_URL=http://routing:8000

# Dirección interna de Notification
NOTIFICATION_URL=http://notification:8000

# Dirección interna de Billing
BILLING_URL=http://billing:8000

# Nivel de los logs JSON
LOG_LEVEL=INFO
