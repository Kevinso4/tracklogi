# Variables de entorno de Routing Service. Copia este archivo a .env y ajusta los valores.
# Nunca subas el .env real: en la nube (Render) se configuran en el panel de la plataforma.

# Conexión a la base de datos propia del servicio
DATABASE_URL=postgresql+psycopg://logitrack:logitrack@postgres:5432/routing_db

# Conexión a RabbitMQ (bus de eventos)
RABBITMQ_URL=amqp://logitrack:logitrack@rabbitmq:5672/

# Opcional. Esquema propio cuando varios servicios comparten una instancia (Render)
DB_SCHEMA=

# Nivel de los logs JSON
LOG_LEVEL=INFO

# Proveedor de rutas (API externa)
OSRM_URL=https://router.project-osrm.org

# Dirección interna de Shipment (reconciliación)
SHIPMENT_URL=http://shipment:8000
