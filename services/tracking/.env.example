# Variables de entorno de Tracking Ingestion Service. Copia este archivo a .env y ajusta los valores.
# Nunca subas el .env real: en la nube (Render) se configuran en el panel de la plataforma.

# Conexión a la base de datos propia del servicio
DATABASE_URL=postgresql+psycopg://logitrack:logitrack@postgres:5432/tracking_db

# Conexión a RabbitMQ (bus de eventos)
RABBITMQ_URL=amqp://logitrack:logitrack@rabbitmq:5672/

# Opcional. Esquema propio cuando varios servicios comparten una instancia (Render)
DB_SCHEMA=

# Nivel de los logs JSON
LOG_LEVEL=INFO

# true: ejecuta el simulador GPS dentro del mismo contenedor
SIMULADOR=false

# Minutos que el simulador sigue activo tras la última visita
SIMULADOR_MINUTOS_ACTIVIDAD=10
