{
  // Terminal → Run Task… (o Ctrl+Shift+P → "Tasks: Run Task")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar LogiTrack",
      "detail": "Backend en Docker + panel web en http://localhost:3000",
      "dependsOrder": "sequence",
      "dependsOn": ["Backend (Docker)", "Panel web"],
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": []
    },
    {
      "label": "Backend (Docker)",
      "type": "shell",
      "command": "docker compose up -d",
      "problemMatcher": []
    },
    {
      "label": "Panel web",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^_never_$" },
        "background": { "activeBegins": true, "beginsPattern": "next dev", "endsPattern": "Ready in" }
      }
    },
    {
      "label": "Reiniciar datos (dejar limpio)",
      "detail": "Borra los datos de prueba y vuelve a los 8 camiones de ejemplo",
      "type": "shell",
      "command": "docker compose down -v; docker compose up -d",
      "problemMatcher": []
    },
    {
      "label": "Detener todo",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    }
  ]
}
